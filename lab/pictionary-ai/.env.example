# Copia questo file in .env e riempi i valori. .env non va mai su git.
ANTHROPIC_API_KEY=
# Stringa lunga e casuale per firmare i token di round, es. output di: openssl rand -hex 32
ROUND_SECRET=
# Porta del server API (il client Vite inoltra /api qui)
API_PORT=8787
# Solo quando il server sarà dietro un proxy (hosting): 1 = fidati del primo proxy per l'IP
# TRUST_PROXY=1
# Modello con visione per indovinare e disegnare (facoltativo)
AI_MODEL=claude-sonnet-5-5
